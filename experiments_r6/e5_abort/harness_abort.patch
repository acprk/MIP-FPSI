 using namespace mip;
 
+// Runs one party. If it throws, the exception is recorded and the party's end of the in-memory
+// channel is closed, so that the peer's pending (or next) send/recv completes with an error
+// instead of waiting forever; both parties then terminate and main exits non-zero.
+static coproto::task<void> guarded(coproto::task<void> party, coproto::Socket& sock, std::exception_ptr& err)
+{
+    try
+    {
+        co_await std::move(party);
+    }
+    catch (...)
+    {
+        err = std::current_exception();
+    }
+    if (err)
+        co_await sock.close();
+}
+
+static std::string what(const std::exception_ptr& e)
+{
+    try { std::rethrow_exception(e); }
+    catch (const std::exception& ex) { return ex.what(); }
+    catch (...) { return "unknown exception"; }
+}
+
 int main(int argc, char** argv)
 {
